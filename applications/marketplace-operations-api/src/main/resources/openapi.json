{
  "openapi": "3.1.0",
  "info": {
    "title": "Flooow Marketplace Operations API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/marketplace-operations/inventory-risk-assessments": {
      "post": {
        "operationId": "assessInventoryRisk",
        "security": [{ "serviceBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InventoryRiskRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Durable inventory-risk assessment created",
            "headers": {
              "Location": {
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InventoryRiskResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "400": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/marketplace-operations/inventory-risk-assessments/{assessmentId}": {
      "get": {
        "operationId": "getInventoryRiskAssessment",
        "security": [{ "serviceBearer": [] }],
        "parameters": [
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted inventory-risk assessment",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InventoryRiskResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "400": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/sales-intelligence/refresh": {
      "post": {
        "operationId": "refreshSalesIntelligence",
        "security": [{ "serviceBearer": [] }],
        "responses": {
          "200": {
            "description": "Bounded live refresh completed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SalesIntelligenceRefresh" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/sales-intelligence/orders": {
      "get": {
        "operationId": "listSalesIntelligenceOrders",
        "security": [{ "serviceBearer": [] }],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Opaque authenticated continuation cursor"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Organization-scoped Sales Intelligence page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SalesIntelligencePage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/sales-intelligence/orders/{marketplaceOrderId}": {
      "get": {
        "operationId": "getSalesIntelligenceOrder",
        "security": [{ "serviceBearer": [] }],
        "parameters": [
          {
            "name": "marketplaceOrderId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current durable Sales Intelligence projection",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SalesIntelligenceOrder" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is live",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is ready",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openApiDocument",
        "security": [{ "serviceBearer": [] }],
        "responses": {
          "200": {
            "description": "Committed OpenAPI 3.1 contract",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "Problem": {
        "description": "Problem detail",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    },
    "schemas": {
      "InventoryRiskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "periodEnd",
          "targetUnits",
          "unitsSold",
          "availableUnits",
          "dailySalesVelocity",
          "observedOn",
          "expectedReplenishmentOn"
        ],
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "periodEnd": { "type": "string", "format": "date" },
          "targetUnits": { "type": "integer", "minimum": 1 },
          "unitsSold": { "type": "integer", "minimum": 0 },
          "availableUnits": { "type": "integer", "minimum": 0 },
          "dailySalesVelocity": { "type": "integer", "minimum": 1 },
          "observedOn": { "type": "string", "format": "date" },
          "expectedReplenishmentOn": { "type": "string", "format": "date" }
        }
      },
      "InventoryRiskResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assessmentId", "recordedAt", "sku", "observedOn", "projection", "recommendation", "expectedImpact", "trace"],
        "properties": {
          "assessmentId": { "type": "string", "format": "uuid" },
          "recordedAt": { "type": "string", "format": "date-time" },
          "sku": { "type": "string" },
          "observedOn": { "type": "string", "format": "date" },
          "projection": { "$ref": "#/components/schemas/InventoryProjection" },
          "recommendation": { "$ref": "#/components/schemas/Recommendation" },
          "expectedImpact": { "type": "string" },
          "trace": { "type": "array", "items": { "type": "string" } }
        }
      },
      "InventoryProjection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stockCoverageDays",
          "projectedStockoutOn",
          "expectedReplenishmentOn",
          "projectedStockoutDays",
          "unitsPotentiallyUnavailable",
          "unitsRemainingToGoal",
          "unitsAtRiskAgainstGoal",
          "shortageProjected"
        ],
        "properties": {
          "stockCoverageDays": { "type": "integer" },
          "projectedStockoutOn": { "type": "string", "format": "date" },
          "expectedReplenishmentOn": { "type": "string", "format": "date" },
          "projectedStockoutDays": { "type": "integer" },
          "unitsPotentiallyUnavailable": { "type": "integer" },
          "unitsRemainingToGoal": { "type": "integer" },
          "unitsAtRiskAgainstGoal": { "type": "integer" },
          "shortageProjected": { "type": "boolean" }
        }
      },
      "Recommendation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "explanation", "expectedUnitsPreserved"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["EXPEDITE_REPLENISHMENT", "REDUCE_PROMOTIONAL_EXPOSURE", "TAKE_NO_ACTION"]
          },
          "explanation": { "type": "string" },
          "expectedUnitsPreserved": { "type": "integer" }
        }
      },
      "SalesIntelligencePage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orders"],
        "properties": {
          "orders": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SalesIntelligenceOrder" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "SalesIntelligenceOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marketplaceOrderId",
          "sourceEvidenceVersion",
          "projectedAt",
          "assemblyPolicyVersion",
          "state"
        ],
        "properties": {
          "marketplaceOrderId": { "type": "string", "format": "uuid" },
          "sourceEvidenceVersion": { "type": "integer", "minimum": 0 },
          "projectedAt": { "type": "string", "format": "date-time" },
          "assemblyPolicyVersion": { "type": "string" },
          "calculationPolicyVersion": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["UNRESOLVED", "CALCULATED_COMPLETE", "CALCULATED_INCOMPLETE"]
          },
          "unresolvedReasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "missingComponentTypes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "partialComponentTypes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "economicResult": { "$ref": "#/components/schemas/SafeEconomicResult" }
        }
      },
      "SafeEconomicResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderOccurredAt",
          "currency",
          "grossRevenue",
          "totalMarketplaceFees",
          "totalShipping",
          "totalAdvertising",
          "totalTaxes",
          "totalProductCost",
          "totalFinancialCost",
          "totalOtherAdjustments",
          "contribution",
          "truthQuality"
        ],
        "properties": {
          "orderOccurredAt": { "type": "string", "format": "date-time" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "grossRevenue": { "type": "string" },
          "totalMarketplaceFees": { "type": "string" },
          "totalShipping": { "type": "string" },
          "totalAdvertising": { "type": "string" },
          "totalTaxes": { "type": "string" },
          "totalProductCost": { "type": "string" },
          "totalFinancialCost": { "type": "string" },
          "totalOtherAdjustments": { "type": "string" },
          "contribution": { "type": "string" },
          "contributionMargin": { "type": "string" },
          "contributionMarginUndefinedReason": { "type": "string" },
          "truthQuality": { "type": "string", "enum": ["CONFIRMED", "ESTIMATED"] }
        }
      },
      "SalesIntelligenceRefresh": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "source", "occurrence", "revenue", "projection"],
        "properties": {
          "status": { "type": "string", "const": "COMPLETED" },
          "source": { "$ref": "#/components/schemas/RefreshSourceSummary" },
          "occurrence": { "$ref": "#/components/schemas/RefreshPromotionSummary" },
          "revenue": { "$ref": "#/components/schemas/RefreshPromotionSummary" },
          "projection": { "$ref": "#/components/schemas/RefreshProjectionSummary" }
        }
      },
      "RefreshSourceSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "invocations", "committedPages", "alreadyCommittedPages", "records"],
        "properties": {
          "status": { "type": "string", "enum": ["EXHAUSTED", "BOUNDED", "RETRYABLE_FAILURE", "FAILED"] },
          "invocations": { "type": "integer", "minimum": 0 },
          "committedPages": { "type": "integer", "minimum": 0 },
          "alreadyCommittedPages": { "type": "integer", "minimum": 0 },
          "records": { "type": "integer", "minimum": 0 }
        }
      },
      "RefreshPromotionSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batches", "examined", "promoted", "duplicates", "identityConflicts", "evidenceConflicts", "drained"],
        "properties": {
          "batches": { "type": "integer", "minimum": 0 },
          "examined": { "type": "integer", "minimum": 0 },
          "promoted": { "type": "integer", "minimum": 0 },
          "duplicates": { "type": "integer", "minimum": 0 },
          "identityConflicts": { "type": "integer", "minimum": 0 },
          "evidenceConflicts": { "type": "integer", "minimum": 0 },
          "drained": { "type": "boolean" }
        }
      },
      "RefreshProjectionSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batches", "processedChanges", "drained"],
        "properties": {
          "batches": { "type": "integer", "minimum": 0 },
          "processedChanges": { "type": "integer", "minimum": 0 },
          "drained": { "type": "boolean" }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "detail", "instance", "code"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "const": "UP" }
        }
      }
    }
  }
}
