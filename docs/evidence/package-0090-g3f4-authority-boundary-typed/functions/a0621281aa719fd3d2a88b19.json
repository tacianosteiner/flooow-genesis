  "language": "plpgsql",
  "source": "applications/marketplace-operations-persistence-postgres/src/main/resources/db/migration/V039__restrict_transaction_identity_runtime_privileges.sql",
  "source_line_range": [
    69,
    131
  ],
  "body": "\nDECLARE\n    resource text;\nBEGIN\n    IF NOT public.command_authorization_organization_lock(org) THEN\n        RAISE EXCEPTION 'Command authority unavailable'\n            USING ERRCODE='P0012';\n    END IF;\n\n    PERFORM 1\n      FROM public.command_principal\n     WHERE organization_id=org\n       AND principal_id=actor\n     FOR UPDATE;\n\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Command authority unavailable'\n            USING ERRCODE='P0012';\n    END IF;\n\n    PERFORM pg_catalog.pg_advisory_xact_lock(\n        pg_catalog.hashtextextended(\n            'transaction-identity/id/1:' || org || ':' || id,\n            0\n        )\n    );\n\n    IF NOT public.transaction_identity_progress_lock(org,conn) THEN\n        RAISE EXCEPTION 'Identity evidence unavailable'\n            USING ERRCODE='P0002';\n    END IF;\n\n    FOR resource IN\n        SELECT unnest(ARRAY[\n            'transaction-identity/subject/1:' ||\n                org || ':' ||\n                conn || ':' ||\n                pg_catalog.octet_length(ref) || ':' ||\n                ref,\n            'transaction-identity/target/1:' ||\n                org || ':' ||\n                target\n        ])\n        ORDER BY 1\n    LOOP\n        PERFORM pg_catalog.pg_advisory_xact_lock(\n            pg_catalog.hashtextextended(resource,0)\n        );\n    END LOOP;\nEND;\n",
  "body_first_line": 81,
