  "body": "\nDECLARE\n    locked boolean;\nBEGIN\n    SELECT true\n      INTO locked\n      FROM public.integration_connector_progress\n     WHERE organization_id=org\n       AND connection_id=conn\n       AND capability='marketplace-economic.omie-transaction-evidence.reacquisition-v3'\n     FOR UPDATE;\n\n    RETURN coalesce(locked,false);\nEND;\n",
